APP_ENV=development
FIREBASE_PROJECT_ID=demo-kyc
USE_EMULATOR=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# For real Firestore, set this to a private service-account JSON path.
GOOGLE_APPLICATION_CREDENTIALS=./credentials/service-account.json
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=20
ALLOWED_EXTENSIONS=.pdf,.docx,.jpg,.jpeg,.png
DOCUMENT_RETENTION_MINUTES=0
PDF_MIN_TEXT_CHARS_PER_PAGE=50
PDF_MIN_ALNUM_RATIO=0.5
MAX_FILES_PER_CASE=15
OCR_ENGINE=paddleocr